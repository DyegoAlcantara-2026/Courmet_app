<?xml version="1.0" encoding="utf-8"?>
<!--
    Tela "Usuários": cabeçalho + busca + lista (RecyclerView) + botão flutuante.
    O FrameLayout raiz (id "main") recebe o padding das barras do sistema (edge-to-edge),
    então tudo dentro dele, inclusive o botão "Novo usuário", fica acima da barra de navegação.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".usuarios.UsuarioListActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Cabeçalho: voltar + título serifado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonBack"
                style="@style/Widget.Courmet.UsuarioList.BackButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/usuario_list_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="@string/usuario_list_title"
                android:textAppearance="@style/TextAppearance.Courmet.ScreenTitle" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="6dp"
            android:text="@string/usuario_list_subtitle"
            android:textAppearance="@style/TextAppearance.Courmet.Caption" />

        <!-- Quantidade de usuários ("3 usuários"); o texto é montado no Java com <plurals> -->
        <TextView
            android:id="@+id/textContagem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Courmet.UsuarioList.Count"
            tools:text="3 usuários" />

        <!-- Busca: filtra a lista já carregada, sem ir ao banco de novo -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutBusca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            app:startIconContentDescription="@string/usuario_list_search_hint"
            app:startIconDrawable="@drawable/ic_usuario_list_search"
            app:startIconTint="@color/text_muted">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputBusca"
                style="@style/Widget.Courmet.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/usuario_list_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Área da lista: a RecyclerView e o aviso de "lista vazia" ocupam o mesmo espaço -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!--
                paddingBottom grande + clipToPadding=false: o último cartão consegue
                rolar para cima do botão flutuante, sem ficar escondido atrás dele.
            -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerUsuarios"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="24dp"
                android:paddingTop="12dp"
                android:paddingEnd="24dp"
                android:paddingBottom="96dp"
                tools:listitem="@layout/item_usuario" />

            <LinearLayout
                android:id="@+id/layoutVazio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingBottom="64dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/textVazioTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/usuario_list_empty"
                    android:textAppearance="@style/TextAppearance.Courmet.SectionTitle" />

                <TextView
                    android:id="@+id/textVazioDica"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/usuario_list_empty_hint"
                    android:textAppearance="@style/TextAppearance.Courmet.Caption" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Botão flutuante "Novo usuário" no canto inferior direito -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabNovo"
        style="@style/Widget.Courmet.UsuarioList.Fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:text="@string/usuario_list_new"
        app:icon="@drawable/ic_usuario_list_add" />
</FrameLayout>
