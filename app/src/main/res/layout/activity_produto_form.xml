<?xml version="1.0" encoding="utf-8"?>
<!-- Tela de cadastro/edição de produto. O NestedScrollView deixa rolar o conteúdo
     quando o teclado aparece (o espaço do teclado vira padding, no código). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true"
    tools:context=".produtos.ProdutoFormActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- Cabeçalho: voltar + título ("Novo item" ou "Editar item", definido no código) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonVoltar"
                style="@style/Widget.Courmet.ProdutoForm.BackButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/produto_form_voltar" />

            <TextView
                android:id="@+id/textTitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Courmet.ScreenTitle"
                tools:text="@string/produto_form_titulo_novo" />
        </LinearLayout>

        <!-- Nome (obrigatório) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:labelFor="@id/inputNome"
            android:text="@string/produto_form_nome_label"
            android:textAppearance="@style/TextAppearance.Courmet.Label" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputNome"
                style="@style/Widget.Courmet.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/produto_form_nome_hint"
                android:imeOptions="actionNext"
                android:inputType="textCapSentences"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Descrição (opcional, várias linhas) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:labelFor="@id/inputDescricao"
            android:text="@string/produto_form_descricao_label"
            android:textAppearance="@style/TextAppearance.Courmet.Label" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutDescricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputDescricao"
                style="@style/Widget.Courmet.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="@string/produto_form_descricao_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Categoria: só um chip pode ficar marcado (singleSelection)
             e sempre há um marcado (selectionRequired). Padrão: Comida. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/produto_form_categoria_label"
            android:textAppearance="@style/TextAppearance.Courmet.Label" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:checkedChip="@id/chipComida"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipComida"
                style="@style/Widget.Courmet.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/produto_form_categoria_comida" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBebida"
                style="@style/Widget.Courmet.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/produto_form_categoria_bebida" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Preço: android:digits permite digitar vírgula OU ponto -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:labelFor="@id/inputPreco"
            android:text="@string/produto_form_preco_label"
            android:textAppearance="@style/TextAppearance.Courmet.Label" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutPreco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputPreco"
                style="@style/Widget.Courmet.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:digits="0123456789.,"
                android:hint="@string/produto_form_preco_hint"
                android:imeOptions="actionDone"
                android:inputType="numberDecimal"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Espaço flexível: empurra os botões para o rodapé em telas altas -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="32dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSalvar"
            style="@style/Widget.Courmet.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/produto_form_salvar" />

        <!-- Só aparece no modo edição (visibilidade controlada no código) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonExcluir"
            style="@style/Widget.Courmet.ProdutoForm.Button.Delete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/produto_form_excluir"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
