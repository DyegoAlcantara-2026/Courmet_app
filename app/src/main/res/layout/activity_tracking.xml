<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".TrackingActivity">

    <!-- Cabeçalho: voltar + título serifado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/buttonBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/tracking_back"
            android:src="@drawable/ic_tracking_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:text="@string/tracking_title"
            android:textAppearance="@style/TextAppearance.Courmet.ScreenTitle" />
    </LinearLayout>

    <View style="@style/Widget.Courmet.Tracking.Divider" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Mapa (View customizada) com o horário estimado por cima -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp">

                <com.example.courmet.TrackingMapView
                    android:id="@+id/mapView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/tracking_map_description" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="36dp"
                    android:layout_marginTop="26dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textEtaLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tracking_eta_label"
                        android:textAppearance="@style/TextAppearance.Courmet.Tracking.EtaLabel" />

                    <TextView
                        android:id="@+id/textEtaValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tracking_eta_value"
                        android:textAppearance="@style/TextAppearance.Courmet.Tracking.EtaValue" />
                </LinearLayout>
            </FrameLayout>

            <View style="@style/Widget.Courmet.Tracking.Divider" />

            <!-- Status do pedido -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                android:text="@string/tracking_status_caption"
                android:textAppearance="@style/TextAppearance.Courmet.Tracking.Overline" />

            <!-- Etapas (preenchidas em TrackingActivity a partir de item_tracking_step) -->
            <LinearLayout
                android:id="@+id/stepsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="22dp" />

            <View style="@style/Widget.Courmet.Tracking.Divider" />

            <!-- Entregador -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingTop="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/tracking_courier_photo"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_tracking_courier"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Courmet.Tracking.Circle" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tracking_courier_name"
                        android:textAppearance="@style/TextAppearance.Courmet.Tracking.CourierName" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/tracking_courier_subtitle"
                        android:textAppearance="@style/TextAppearance.Courmet.Caption" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/buttonChat"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_tracking_chat_button"
                    android:contentDescription="@string/tracking_chat"
                    android:src="@drawable/ic_tracking_chat" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
