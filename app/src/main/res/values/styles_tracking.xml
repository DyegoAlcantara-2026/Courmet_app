<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Linha divisória de 1dp -->
    <style name="Widget.Courmet.Tracking.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/border</item>
    </style>

    <!-- "Tempo estimado de entrega" sobre o mapa -->
    <style name="TextAppearance.Courmet.Tracking.EtaLabel" parent="TextAppearance.Courmet.Label">
        <item name="android:textSize">12sp</item>
    </style>

    <!-- "13:15 - 13:25" -->
    <style name="TextAppearance.Courmet.Tracking.EtaValue" parent="TextAppearance.Courmet.Label">
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="fontFamily">@font/manrope_bold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <!-- "STATUS DO PEDIDO" -->
    <style name="TextAppearance.Courmet.Tracking.Overline" parent="TextAppearance.Courmet.Label">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Título de cada etapa (a cor muda conforme o estado, no código) -->
    <style name="TextAppearance.Courmet.Tracking.StepTitle" parent="TextAppearance.Courmet.Label">
        <item name="android:fontFamily">@font/manrope_medium</item>
        <item name="fontFamily">@font/manrope_medium</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Nome do entregador -->
    <style name="TextAppearance.Courmet.Tracking.CourierName" parent="TextAppearance.Courmet.Label">
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="fontFamily">@font/manrope_bold</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Forma circular para o avatar (ShapeableImageView) -->
    <style name="ShapeAppearance.Courmet.Tracking.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>
