<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tipografia -->
    <style name="TextAppearance.Courmet.Logo" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/instrument_serif</item>
        <item name="fontFamily">@font/instrument_serif</item>
        <item name="android:textSize">44sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <!-- Títulos serifados das telas ("Pedido", "Acompanhamento", "Promoções"...) -->
    <style name="TextAppearance.Courmet.ScreenTitle" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/instrument_serif</item>
        <item name="fontFamily">@font/instrument_serif</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.Courmet.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="fontFamily">@font/manrope_bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.Courmet.SectionTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="fontFamily">@font/manrope_bold</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.Courmet.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/manrope_regular</item>
        <item name="fontFamily">@font/manrope_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Courmet.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/manrope_semibold</item>
        <item name="fontFamily">@font/manrope_semibold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.Courmet.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/manrope_regular</item>
        <item name="fontFamily">@font/manrope_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="TextAppearance.Courmet.Link" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/manrope_semibold</item>
        <item name="fontFamily">@font/manrope_semibold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/gold</item>
    </style>

    <!-- Estilo padrão de TextView (Manrope) -->
    <style name="Widget.Courmet.TextView" parent="Widget.AppCompat.TextView">
        <item name="android:textAppearance">@style/TextAppearance.Courmet.Body</item>
    </style>

    <!-- Campos de texto -->
    <style name="Widget.Courmet.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="hintEnabled">false</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="endIconTint">@color/text_muted</item>
    </style>

    <style name="Widget.Courmet.EditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:fontFamily">@font/manrope_regular</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- Botões -->
    <style name="Widget.Courmet.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">54dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/ink</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.Courmet.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="iconTint">@color/ink</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">16dp</item>
        <item name="iconPadding">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/manrope_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- Chips de filtro/seleção (pílulas: ativo preto, inativo branco) -->
    <style name="Widget.Courmet.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeColor">@color/border</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Courmet.Label</item>
        <item name="chipStartPadding">10dp</item>
        <item name="chipEndPadding">10dp</item>
    </style>

    <!-- Botão de texto (ex.: "Esqueceu sua senha?") -->
    <style name="Widget.Courmet.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/gold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/manrope_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="rippleColor">@color/gold_soft</item>
    </style>

</resources>
