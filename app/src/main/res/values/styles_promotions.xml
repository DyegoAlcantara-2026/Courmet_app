<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Cartão branco com borda fina de cada promoção -->
    <style name="Widget.Courmet.Promotions.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Banner escuro (sem borda) -->
    <style name="Widget.Courmet.Promotions.Banner" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/ink</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Botão redondo branco de filtro -->
    <style name="Widget.Courmet.Promotions.FilterButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">22dp</item>
        <item name="icon">@drawable/ic_promotions_filter</item>
        <item name="iconTint">@color/ink</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="rippleColor">@color/gold_soft</item>
    </style>

    <style name="TextAppearance.Courmet.Promotions.BannerTitle" parent="TextAppearance.Courmet.ScreenTitle">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextAppearance.Courmet.Promotions.BannerSubtitle" parent="TextAppearance.Courmet.Body">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextAppearance.Courmet.Promotions.Badge" parent="TextAppearance.Courmet.Label">
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="fontFamily">@font/manrope_bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextAppearance.Courmet.Promotions.Name" parent="TextAppearance.Courmet.SectionTitle">
        <item name="android:textSize">17sp</item>
    </style>

    <style name="TextAppearance.Courmet.Promotions.Rating" parent="TextAppearance.Courmet.Label" />

    <style name="TextAppearance.Courmet.Promotions.Restaurant" parent="TextAppearance.Courmet.Body">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="TextAppearance.Courmet.Promotions.OldPrice" parent="TextAppearance.Courmet.Caption">
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TextAppearance.Courmet.Promotions.NewPrice" parent="TextAppearance.Courmet.SectionTitle">
        <item name="android:textSize">18sp</item>
    </style>
</resources>
