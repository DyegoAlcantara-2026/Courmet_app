<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Cartões brancos com borda fina (FAQ e contatos) -->
    <style name="Widget.Courmet.Support.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Botão circular de voltar -->
    <style name="Widget.Courmet.Support.BackButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="icon">@drawable/ic_support_back</item>
        <item name="iconTint">@color/ink</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="rippleColor">@color/gold_soft</item>
    </style>

    <style name="TextAppearance.Courmet.Support.Question" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/manrope_semibold</item>
        <item name="fontFamily">@font/manrope_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.Courmet.Support.Answer" parent="TextAppearance.Courmet.Body">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="TextAppearance.Courmet.Support.ContactTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="fontFamily">@font/manrope_bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.Courmet.Support.ContactSubtitle" parent="TextAppearance.Courmet.Caption">
        <item name="android:textSize">13sp</item>
    </style>
</resources>
